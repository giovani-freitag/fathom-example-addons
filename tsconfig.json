{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["vite/client", "node"],

        // Where `import … from 'fathom'` resolves. The same line the published
        // package asks for, pointed at the vendored copy until it is on npm.
        "paths": { "fathom": ["./types/fathom.d.ts"] },

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,

        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true
    },
    "include": ["readings", "src", "scripts", "tests", "types", "*.ts", "*.js"]
}
